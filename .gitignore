# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build docs (contain PII / internal planning — exclude from production)
realContentData.md
technicalPlan.md
portfolio-v2-build-prompt.md

# raw / source image folders (only webp used in the project should be committed)
/part1/
/part2/
/indiainnovate-blog/

# raw image formats — only .webp media is used in the project/blog
*.jpg
*.jpeg
*.png
# but keep the committed OG image (referenced in every page's metadata)
!public/og-image.png

# local dev artifacts / scratch files
/dev.log
/next-start.log
/next-start.log.*
*.log
/temp_response.txt
/lighthouse-report.json
/redesign-prototype/
/.opencode/
/opencode.json
/technicalPlan.md.bak
CLAUDE.md
/background-variants/
/docs/
page.html
test_*.html
